generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  clerkUserId          String?               @unique
  email                String                @unique
  displayName          String
  firstName            String
  passwordHash         String?
  passwordSalt         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  addresses            CustomerAddress[]
  favorites            Favorite[]
  quoteRequests        QuoteRequest[]
  sharedCartLinks      SharedCartLink[]
  supportConversations SupportConversation[]
}

model CustomerAddress {
  id            String          @id @default(cuid())
  userId        String
  label         String
  recipientName String
  phone         String
  email         String?
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String?
  countryCode   String
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isDefault])
}

model Favorite {
  id          String   @id @default(cuid())
  userId      String
  productSlug String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productSlug])
  @@index([productSlug])
}

model QuoteRequest {
  id             String   @id @default(cuid())
  userId         String
  productName    String
  quantity       String
  specifications String
  budget         String
  shippingWindow String
  notes          String?
  status         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SupportConversation {
  id        String           @id @default(cuid())
  userId    String
  tab       String
  name      String
  email     String?
  role      String
  preview   String
  time      String
  status    String
  aiEnabled Boolean          @default(false)
  orderId   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  SupportMessage[]

  @@index([userId, updatedAt])
  @@index([orderId])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  side           String
  text           String
  createdAt      DateTime            @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}


model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  label           String
  description     String?
  amountType      String
  amountValue     Int
  minOrderFcfa    Int      @default(0)
  maxDiscountFcfa Int?
  active          Boolean  @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  usageLimit      Int?
  usageCount      Int      @default(0)
  usedOrderIds    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

model SharedCartLink {
  id                   String    @id
  token                String    @unique
  ownerUserId          String
  ownerEmail           String
  ownerDisplayName     String
  message              String?
  itemsPayload         Json
  status               String
  claimCount           Int       @default(0)
  lastClaimedAt        DateTime?
  claimedByUserId      String?
  claimedByDisplayName String?
  claimedOrderId       String?
  expiresAt            DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  owner                User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt])
  @@index([status, expiresAt])
}

model FreeDealConfigRecord {
  id                   String   @id
  enabled              Boolean  @default(true)
  pageTitle            String
  heroBadge            String
  heroTitle            String
  heroSubtitle         String
  bannerText           String
  ctaLabel             String
  shareTitle           String
  shareDescription     String
  itemLimit            Int
  fixedPriceEur        Float
  referralGoal         Int
  dealTagText          String
  productBadgeText     String
  compareAtMultiplier  Float
  compareAtExtraEur    Float
  productSlugs         Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([updatedAt])
}

model FreeDealClaimRecord {
  id                   String   @id
  status               String
  userId               String?
  customerEmail        String?
  customerName         String?
  orderId              String?
  referralCode         String   @unique
  deviceIdHash         String
  ipHash               String?
  userAgentHash        String?
  referralGoal         Int
  referralVisitCount   Int      @default(0)
  itemLimit            Int
  fixedPriceEur        Float
  fixedPriceFcfa       Int
  selectedProductSlugs Json
  paidAt               DateTime?
  unlockedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  visits               FreeDealReferralVisitRecord[]

  @@index([createdAt])
  @@index([orderId])
  @@index([customerEmail])
  @@index([deviceIdHash])
}

model FreeDealReferralVisitRecord {
  id                   String   @id
  claimId              String
  referralCode         String
  visitorKeyHash       String
  visitorDeviceHash    String
  visitorIpHash        String?
  visitorUserAgentHash String?
  counted              Boolean  @default(true)
  createdAt            DateTime @default(now())
  claim                FreeDealClaimRecord @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, visitorKeyHash])
  @@index([referralCode, createdAt])
  @@index([claimId, counted])
}